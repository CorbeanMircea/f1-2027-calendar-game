# Secrets and local configuration: never commit these
.env
.env.*
*.pem
*.key

# Local-only assets (trademarked logos, driver photos, print files)
local-assets/
*.psd

# Tooling output
node_modules/
.DS_Store
Thumbs.db

assets/hero-originals/

# Handoff snapshots made for review (copies of the source and history)
lights-out-full-handoff-*/

# Driver photo originals are not committed; only their credits list is
assets/portraits-originals/*
!assets/portraits-originals/credits.csv
!assets/portraits-originals/focus.csv

# Playwright test output and saved sign-in state (milestone T1)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.auth/

# Supabase CLI cache folders (created when the CLI runs; machine-specific)
supabase/.temp/
supabase/.branches/
tests/db/supabase/.temp/
tests/db/supabase/.branches/
